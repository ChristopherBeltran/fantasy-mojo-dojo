generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per Sleeper league you connect. Supports multiple seasons/leagues later.
model League {
  id              String     @id @default(cuid())
  sleeperLeagueId String     @unique
  name            String
  season          String
  totalRosters    Int
  settingsJson    Json // raw sleeper league settings, kept for reference
  managers        Manager[]
  matchups        Matchup[]
  bonuses         Bonus[]
  posters         MatchupPoster[]
  lmsEliminations LastManStandingElimination[]
  lastSyncedAt    DateTime?
  createdAt       DateTime   @default(now())
}

// One row per team/owner in the league
model Manager {
  id              String    @id @default(cuid())
  league          League    @relation(fields: [leagueId], references: [id])
  leagueId        String
  sleeperUserId   String
  rosterId        Int
  displayName     String
  teamName        String?
  avatarUrl       String?
  // Commissioner-uploaded reference photos (up to 3, see the photo upload
  // route), used to generate weekly matchup posters.
  photos          ManagerPhoto[]
  // Commissioner-set real-world NFL team, matched against NFL_TEAMS in src/lib/nflTeams.ts.
  favoriteNflTeam String?
  matchupsAsHome  Matchup[] @relation("HomeManager")
  matchupsAsAway  Matchup[] @relation("AwayManager")
  postersAsA      MatchupPoster[] @relation("PosterManagerA")
  postersAsB      MatchupPoster[] @relation("PosterManagerB")
  lmsEliminations LastManStandingElimination[]

  @@unique([leagueId, rosterId])
}

// A single reference photo for a manager. Capped at 3 per manager (enforced
// in the upload route, not here) — all of a manager's photos are fed to
// Gemini as reference images when generating that manager's matchup posters.
model ManagerPhoto {
  id        String   @id @default(cuid())
  manager   Manager  @relation(fields: [managerId], references: [id])
  managerId String
  url       String
  createdAt DateTime @default(now())

  @@index([managerId])
}

// One row per team, per week. This is the table almost every bonus computes over.
model Matchup {
  id               String   @id @default(cuid())
  league           League   @relation(fields: [leagueId], references: [id])
  leagueId         String
  week             Int
  season           String
  isPlayoff        Boolean  @default(false)

  manager          Manager  @relation("HomeManager", fields: [managerId], references: [id])
  managerId        String
  points           Float

  opponent         Manager? @relation("AwayManager", fields: [opponentId], references: [id])
  opponentId       String?
  opponentPoints   Float?

  createdAt        DateTime @default(now())

  @@unique([leagueId, week, managerId])
  @@index([leagueId, week])
}

// A bonus/award definition. dslJson is the AI-generated computation spec —
// see src/lib/bonusInterpreter.ts for how it's executed.
model Bonus {
  id          String        @id @default(cuid())
  league      League        @relation(fields: [leagueId], references: [id])
  leagueId    String
  promptText  String // the original natural-language prompt from the commissioner
  label       String // display name, e.g. "Highest Regular Season Points"
  dslJson     Json // validated DSL spec (see BonusSpecSchema in src/lib/bonusSchema.ts)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  results     BonusResult[]
}

// One row per computation run. Keeping history lets you show "leader changed on week 8" etc.
model BonusResult {
  id           String   @id @default(cuid())
  bonus        Bonus    @relation(fields: [bonusId], references: [id])
  bonusId      String
  computedAt   DateTime @default(now())
  leaderboard  Json // ranked array: [{ managerId, displayName, value }, ...]

  @@index([bonusId, computedAt])
}

// One AI-generated poster per head-to-head pairing, per week. managerAId/
// managerBId are stored in sorted order (see posterGen.ts) so each pairing
// has exactly one canonical row regardless of who's "home"/"away" that week.
// Generation is triggered by the daily cron once it sees a week's pairing
// that doesn't have a poster yet — see generateWeeklyPosters in posterGen.ts.
model MatchupPoster {
  id         String   @id @default(cuid())
  league     League   @relation(fields: [leagueId], references: [id])
  leagueId   String
  week       Int
  season     String
  managerA   Manager  @relation("PosterManagerA", fields: [managerAId], references: [id])
  managerAId String
  managerB   Manager  @relation("PosterManagerB", fields: [managerBId], references: [id])
  managerBId String
  imageUrl   String
  createdAt  DateTime @default(now())

  @@unique([leagueId, week, managerAId, managerBId])
  @@index([leagueId, week])
}

// One row per manager eliminated from the "Last Man Standing" pool, per
// season. Runs weeks 3-14 (see LMS_START_WEEK/LMS_END_WEEK in
// src/lib/lastManStanding.ts): each week the surviving manager with the
// lowest score that week is eliminated. A manager with no row here is still
// alive. The existence of a row for a given week is what makes recomputation
// idempotent — see computeLastManStanding.
model LastManStandingElimination {
  id        String   @id @default(cuid())
  league    League   @relation(fields: [leagueId], references: [id])
  leagueId  String
  season    String
  week      Int
  manager   Manager  @relation(fields: [managerId], references: [id])
  managerId String
  createdAt DateTime @default(now())

  @@unique([leagueId, season, week, managerId])
  @@index([leagueId, season])
}
